{
  "name": "blanger-arte-rustica-api",
  "version": "1.0.0",
  "description": "API RESTful para o e-commerce Blanger Arte Rústica",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest tests/unit --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest tests/unit --watch",
    "db:sync": "node src/database/sync.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "node src/database/sync.js && node src/database/seed.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "sequelize",
    "neon"
  ],
  "author": "Blanger Arte Rústica",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
