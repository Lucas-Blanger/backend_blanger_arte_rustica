PORT=3000
NODE_ENV=development

# String de conexão do banco Neon (Postgres)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.neon.tech/blanger?sslmode=require

# JWT
JWT_SECRET=troque-por-uma-chave-bem-secreta
JWT_EXPIRES_IN=7d

# CORS 
CORS_ORIGIN=*

# SMTP (Envio de E-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Blanger Arte Rústica" <noreply@blangerarterustica.com.br>

